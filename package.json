{
  "name": "@bman654/clodex",
  "version": "2.1.6",
  "publishConfig": {
    "access": "public"
  },
  "description": "Bridge Claude Code to OpenAI models — OpenAI API key or ChatGPT/Codex-plan OAuth, with prompt caching, auto-compaction, model switching, and a Claude Code binary patcher",
  "author": "Brandon Wallace",
  "license": "MIT",
  "keywords": [
    "claude",
    "claude-code",
    "openai",
    "chatgpt",
    "codex",
    "ai",
    "llm",
    "cli",
    "bridge",
    "proxy"
  ],
  "type": "module",
  "packageManager": "bun@1.3.14",
  "bin": {
    "clodex": "dist/cli.js",
    "clodex-claude": "dist/claude-wrapper.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun run scripts/build.ts --watch",
    "install:global": "bun run scripts/install-global.ts",
    "test": "bun test --isolate --parallel=8 --timeout=30000 --only-failures",
    "test:file": "bun test --timeout=30000",
    "lint": "eslint src scripts",
    "lint:dead-code": "knip",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "prepare": "bunx --no-install husky",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.12",
    "@ai-sdk/openai": "4.0.11",
    "@ai-sdk/openai-compatible": "3.0.7",
    "@ai-sdk/provider-utils": "5.0.7",
    "@clack/prompts": "0.9.1",
    "ai": "7.0.22",
    "ink": "7.1.1",
    "ipaddr.js": "2.4.0",
    "node-forge": "1.4.0",
    "open": "11.0.0",
    "picocolors": "1.1.1",
    "react": "19.2.7",
    "secondwind": "0.2.2",
    "tweakcc": "4.3.0",
    "undici": "7.28.0"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@types/bun": "1.3.14",
    "@types/node-forge": "1.3.14",
    "@types/react": "19.2.16",
    "eslint": "10.8.0",
    "husky": "9.1.7",
    "knip": "6.31.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cgasgarth/clodex.git"
  },
  "homepage": "https://github.com/cgasgarth/clodex#readme",
  "bugs": {
    "url": "https://github.com/cgasgarth/clodex/issues"
  }
}
