{
  "name": "@bman654/clodex",
  "version": "3.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Bridge Claude Code to OpenAI and Grok models — OpenAI API key, ChatGPT OAuth, or SuperGrok OAuth, with prompt caching, auto-compaction, model switching, and a Claude Code binary patcher",
  "author": "Brandon Wallace",
  "license": "MIT",
  "keywords": [
    "claude",
    "claude-code",
    "openai",
    "grok",
    "xai",
    "chatgpt",
    "codex",
    "ai",
    "llm",
    "cli",
    "bridge",
    "proxy"
  ],
  "type": "module",
  "packageManager": "bun@1.4.0-canary.1",
  "bin": {
    "clodex": "dist/cli.js",
    "clodex-claude": "dist/claude-wrapper.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.4.0-canary.1"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check:ci": "bun run typecheck && bun run lint && bun run lint:dead-code && bun run lint:lockfile && bun run test && bun run build",
    "benchmark:secondwind-latency": "bun run benchmarks/secondwind/latency.ts",
    "dev": "bun run scripts/build.ts --watch",
    "install:global": "bun run scripts/install-global.ts",
    "test": "bun test --isolate --parallel=8 --timeout=30000 --only-failures",
    "test:file": "bun test --timeout=30000",
    "lint": "oxlint --config oxlint.config.ts .",
    "lint:dead-code": "knip",
    "lint:lockfile": "bun dedupe --check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "prepare": "bunx --no-install husky",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.39",
    "@ai-sdk/openai": "4.0.42",
    "@ai-sdk/openai-compatible": "3.0.31",
    "@ai-sdk/provider-utils": "5.0.27",
    "@ai-sdk/xai": "4.0.40",
    "@clack/prompts": "1.7.0",
    "ai": "7.0.66",
    "ink": "7.1.1",
    "ipaddr.js": "2.5.0",
    "node-forge": "1.4.0",
    "open": "11.0.1",
    "picocolors": "1.1.1",
    "react": "19.2.8",
    "secondwind": "0.3.2",
    "tweakcc": "https://github.com/cgasgarth/clodex-tweakcc/releases/download/v2.7.23/tweakcc-fixed-2.7.23.tgz",
    "undici": "8.10.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node-forge": "1.3.14",
    "@types/react": "19.2.18",
    "@typescript/native": "npm:typescript@7.0.2",
    "@oxlint/plugins": "1.78.0",
    "husky": "9.1.7",
    "knip": "6.32.2",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cgasgarth/clodex.git"
  },
  "homepage": "https://github.com/cgasgarth/clodex#readme",
  "bugs": {
    "url": "https://github.com/cgasgarth/clodex/issues"
  }
}
