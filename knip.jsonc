{
  // Bun 1.4 exposes `dedupe` as a runtime subcommand. Knip treats the
  // subcommand in `bun dedupe --check` as an external executable.
  "ignoreBinaries": ["dedupe"],
  "entry": [
    // Bun Worker entrypoint built separately from the CLI bundle. Keep this
    // explicit: its URL is selected dynamically for source and dist runs.
    "src/daemon/control/worker.ts",
    "src/daemon/secondwind-worker.ts",
    "scripts/*.ts",
    "tests/**/*.test.ts",
    "tests/fixtures/*.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
