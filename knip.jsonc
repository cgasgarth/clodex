{
  "ignoreUnresolved": [
    // Required for Linux CI: this macOS-only executable is intentionally used
    // by launch-agent.ts. Do not remove when local macOS Knip calls it redundant.
    "/bin/launchctl"
  ],
  "entry": [
    // Bun Worker entrypoint built separately from the CLI bundle. Keep this
    // explicit: its URL is selected dynamically for source and dist runs.
    "src/daemon/control/worker.ts",
    "src/daemon/secondwind-worker.ts",
    "scripts/*.ts",
    "tests/**/*.test.ts",
    "tests/fixtures/*.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
